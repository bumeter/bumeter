{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bumeter",
  "version": "1.0.5",
  "identifier": "dev.bumeter.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "license": "GPL-3.0-or-later",
    "shortDescription": "Bumeter: AI usage stats (Claude Code, Kiro, OpenCode)",
    "longDescription": "Track tokens, quotas, skills, and context composition of coding AI tools, running in the background in the tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bum"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/chieund/bumeter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NUY2RTJGNEUyODlGRTEKUldUaG55aE9MMjVmR2F3SzJ6YmUzQUdqRU1vTGlXdEJtaUd1aFBqdHU1S1pqMWVveEpSb1RqeE4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}